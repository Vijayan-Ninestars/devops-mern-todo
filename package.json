{
  "name": "mern-todo",
  "private": true,
  "scripts": {
    "api": "npm --prefix apps/api run dev",
    "web": "npm --prefix apps/web run dev",
    "dev": "concurrently \"npm run api\" \"npm run web\"",
    "install:all": "npm install && npm install --prefix apps/api && npm install --prefix apps/web",
    "build": "npm run build --prefix apps/web",
    "start": "npm run start --prefix apps/api",
    "serve": "npm run build && npm run start"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
