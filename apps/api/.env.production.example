# Backend production env (the ONLY env file). On the server this is /opt/todo/.env.
# The CD workflow generates it from GitHub secrets/variables; copy + edit for a manual deploy.

NODE_ENV=production
PORT=5000

# Database (DB_HOST is forced to "db" by docker-compose.prod.yml)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me-strong-password
DB_NAME=todo_db

# Image selection (set by the CD workflow)
GHCR_OWNER=your-github-username
IMAGE_TAG=latest
